DB_USER=replace-local-user
DB_PASSWORD=replace-local-password
DB_HOST=127.0.0.1
PAMK_REDIS_URL=redis://127.0.0.1:6379/15
PAMK_WORKER_PYTHON=/path/to/ml-venv/bin/python
PAMK_WEB_PYTHON=/path/to/web-venv/bin/python
